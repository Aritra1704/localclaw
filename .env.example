# Core runtime
NODE_ENV=development
LOCAL_ONLY_MODE=true
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/localclaw
DATABASE_SCHEMA=localclaw
SSD_BASE_PATH=.localclaw/workspace

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub
GITHUB_PAT=
GITHUB_USERNAME=
GITHUB_REPO_OWNER=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REPO_VISIBILITY=private
GITHUB_AUTO_PUBLISH=false
GIT_DEFAULT_BRANCH=main

# Railway
RAILWAY_API_TOKEN=
RAILWAY_GRAPHQL_ENDPOINT=https://backboard.railway.com/graphql/v2
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_DEPLOY_ENABLED=false
RAILWAY_DEPLOY_POLL_INTERVAL_MS=10000
RAILWAY_DEPLOY_TIMEOUT_MS=900000

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30s
OLLAMA_REQUEST_TIMEOUT_MS=120000
OLLAMA_WARMUP_ENABLED=true
OLLAMA_WARMUP_TIMEOUT_MS=180000
OLLAMA_MAX_RETRIES=1
MODEL_PLANNER=qwen2.5-coder:7b
MODEL_CODER=qwen2.5-coder:7b
MODEL_FAST=llama3.2:3b
MODEL_REVIEW=qwen2.5-coder:7b
MODEL_EMBED=nomic-embed-text:latest

# Execution controls
TASK_POLL_INTERVAL_MS=30000
TASK_TIMEOUT_HOURS=4
MAX_CONSECUTIVE_FAILURES=3
DOCKER_SANDBOX_ENABLED=false
REPAIR_AUTO_APPROVE=false
DEPLOY_AUTO_APPROVE=false

# Skills
SKILLS_BUILTIN_DIR=skills/builtin
SKILLS_ALLOW_GENERATED=false

# Local control API (CLI/UI bridge)
CONTROL_API_ENABLED=true
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=4173
CONTROL_API_TOKEN=localclaw-dev-token

# Operator UX
LOCALCLAW_WORKSPACE_ROOTS=.
UI_ENABLED=true
UI_DIST_DIR=web/dist
UI_DEV_ORIGIN=http://127.0.0.1:5173
